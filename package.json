{
  "name": "@abstractframework/abstractuic-monorepo",
  "version": "0.8.9",
  "private": true,
  "description": "AbstractUIC - UI packages for AbstractFramework",
  "workspaces": [
    "app-server",
    "ui-kit",
    "monitor-active-memory",
    "monitor-flow",
    "monitor-gpu",
    "monitor-memory",
    "panel-chat"
  ],
  "scripts": {
    "build": "npm --workspaces --if-present run build",
    "test": "npm --workspaces --if-present run test && node scripts/check_relative_urls.mjs && node scripts/check_cross_dist_types.mjs",
    "pack:dry": "npm --workspaces --if-present pack --dry-run",
    "check:urls": "node scripts/check_relative_urls.mjs",
    "check:cross-dist": "node scripts/check_cross_dist_types.mjs"
  }
}
